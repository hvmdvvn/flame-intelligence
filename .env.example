# Export in the process environment. Python does not auto-load .env files.
# Docker Compose reads root .env for variable substitution. Leave LLM_PROVIDER empty
# to run the evidence clerk on verbatim extracts, with no generative model.

LLM_PROVIDER=
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=40

# Optional direct API override for local development; unset to use /service proxy.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# When NEXT_PUBLIC_API_BASE_URL is unset, the frontend proxies /service to this origin.
# Required for a Vercel frontend build: use the deployed backend production URL.
FLAME_API_ORIGIN=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
API_POSTS_PER_MINUTE=30
# Optional operator token to inspect ingestion job status over HTTP; CLI needs none.
FLAME_ADMIN_TOKEN=
